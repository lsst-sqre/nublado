#!/usr/bin/env bash
set -x
set -euo pipefail

# Install the various node-based protocol servers and CLIs.
# These are required both for the CLI and for JupyterLab LLM chat.

npm install --global -y @agentclientprotocol/claude-agent-acp
npm install --global -y @zed-industries/codex-acp
npm install --global -y @openai/codex
npm install --global -y @google/gemini-cli
npm install --global -y skills

# Not sure this works globally, but let's find out.

npx skills add vercel-labs/agent-skills --agent '*' -y
npx skills install -y jupyter-ai-contrib/nb-cli
